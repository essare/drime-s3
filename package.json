{
  "name": "drime-s3",
  "version": "1.4.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "drime-s3": "src/cli/main.ts"
  },
  "scripts": {
    "dev": "bun --hot run src/cli/main.ts serve",
    "start": "bun run src/cli/main.ts serve",
    "smoke:real": "bun run scripts/real-upload-smoke.ts",
    "smoke:multipart": "bun run scripts/multipart-smoke.ts",
    "smoke:multipart:selftest": "bun run scripts/multipart-smoke-selftest.ts",
    "smoke:large:aws": "bun run scripts/real-large-s3-upload.ts",
    "smoke:large:aws:selftest": "bun run scripts/real-large-s3-upload-selftest.ts",
    "smoke:admin": "scripts/smoke/admin-curl-flow.sh",
    "verify:multipart": "bun run scripts/real-large-s3-upload-selftest.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "bun run scripts/build-release.ts",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:test": "bun run --cwd web test",
    "web:lint": "bun run --cwd web lint",
    "web:typecheck": "bun run --cwd web typecheck"
  },
  "dependencies": {
    "fast-xml-parser": "^5.7.3",
    "pino": "^10.3.1",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "^1.3.13",
    "lefthook": "^2.1.6",
    "typescript": "^6.0.3"
  }
}
