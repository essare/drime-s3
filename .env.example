# Optional: for local `bun` development (Bun loads `.env` automatically).
# Docker Compose in this repo uses inline `environment` in docker-compose.yml instead.

# DRIME_API_KEY=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# WEB_UI_PASSWORD=
# WEB_UI_SESSION_SECRET=
# DRIME_S3_HTTP_TRACE=1
# DRIME_S3_HTTP_TRACE_VERBOSE=1
# Strong MD5 ETag on HEAD/GET when metadata is weak (default ON for Duplicati).
# Set to 0 to skip full-body downloads for speed.
# DRIME_S3_STRONG_ETAG=1
# DRIME_S3_CONTENT_ETAG_BUFFER_BYTES=67108864

# Parallel part uploads for gateway-internal multipart PUT (default 12)
# DRIME_S3_MULTIPART_PART_CONCURRENCY=12
