# Copy to .env and fill in values (`.env` is gitignored).
# See README for Docker Compose and AWS CLI usage.

# --- Drime ---
DRIME_API_KEY=
# DRIME_API_BASE_URL=https://app.drime.cloud/api/v1
# DRIME_GATEWAY_WORKSPACE_NAME=drime-s3
# DRIME_GATEWAY_WORKSPACE_ID=

# --- S3 signing (use these with AWS CLI / SDKs) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Web admin UI ---
WEB_UI_PASSWORD=
# Hex string, at least 32 characters (16 bytes), e.g. openssl rand -hex 32
WEB_UI_SESSION_SECRET=

# --- Optional: image and published port ---
# DRIME_S3_IMAGE=ghcr.io/essare/drime-s3:main
# DRIME_S3_PORT=8081

# --- Dev/lab only: do not use on the public internet ---
# DRIME_S3_INSECURE=1
